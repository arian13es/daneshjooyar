<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="دانشجویار دانشگاه تبریز"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="right" />

        <TextView
            android:id="@+id/tv_widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امروز"
            android:textColor="#818CF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Next Class Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@drawable/widget_pill_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_class_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="کلاس بعدی:"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="right" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_class_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="کلاس فعالی برای امروز نیست"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_widget_class_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#64748B"
            android:textSize="10sp"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Next Exam Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="@drawable/widget_pill_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_exam_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="امتحان بعدی:"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="right" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_exam_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="امتحان ثبت‌نشده"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
