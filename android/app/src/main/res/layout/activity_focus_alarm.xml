<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen Focus/Pomodoro Alarm Activity.
  Styled with Vazirmatn typography and a modern luxury dark theme.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fitsSystemWindows="true">

    <!-- Ambient background glow elements -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:background="@drawable/alarm_glow"
        android:alpha="0.45" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <!-- Top university tag / session pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="دانشجویار • پایان زمان مطالعه"
                android:textColor="#818CF8"
                android:textSize="13sp"
                android:fontFamily="@font/vazirmatn_bold" />

            <!-- Animated / Pulsing central glowing circle with timer icon -->
            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="32dp">

                <View
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/alarm_glow" />

                <!-- Circular inner container -->
                <LinearLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/alarm_stop_button"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        android:contentDescription="@string/alarm_icon_description"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>

            <!-- Large Persian Digital Clock -->
            <TextView
                android:id="@+id/alarm_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:fontFamily="@font/vazirmatn_bold"
                android:letterSpacing="0.02"
                android:text="۰۰:۰۰" />

            <!-- Course Title Badge -->
            <TextView
                android:id="@+id/alarm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#F1F5F9"
                android:textSize="22sp"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="دوره تمرکز با موفقیت پایان یافت" />

            <!-- Subtitle message -->
            <TextView
                android:id="@+id/alarm_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:fontFamily="@font/vazirmatn"
                android:text="خسته نباشید! زمان مطالعه ثبت شد. اکنون وقت یک استراحت کوتاه است ☕" />

            <!-- Space pusher -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp" />

            <!-- Stop Button -->
            <Button
                android:id="@+id/alarm_dismiss"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/alarm_stop_button"
                android:text="توقف زنگ و ثبت تمرکز"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/vazirmatn_bold"
                android:stateListAnimator="@null" />

            <!-- Hint below button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:fontFamily="@font/vazirmatn"
                android:text="برای متوقف‌سازی هشدار دکمه بالا را لمس کنید" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
